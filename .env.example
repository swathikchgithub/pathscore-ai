# Copy to .env and fill in to run CortexExtractor against a live Snowflake
# account. If any of these are unset, CortexExtractor automatically falls
# back to a local mock Cortex client -- no Snowflake account required for
# local dev/demo.

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# Exactly one of these three. Key-pair takes priority if more than one is
# set. Prefer SNOWFLAKE_PRIVATE_KEY (or _PATH) over SNOWFLAKE_PASSWORD --
# Snowflake accounts increasingly enforce MFA for password auth, which a
# headless job can't satisfy; key-pair auth is exempt.
SNOWFLAKE_PRIVATE_KEY=            # PEM content (e.g. `cat key.p8`), not a path -- for CI/secrets
SNOWFLAKE_PRIVATE_KEY_PATH=       # path to a local unencrypted PKCS8 key file -- for local dev
SNOWFLAKE_PASSWORD=

# Same idea for LoRAExtractor: set this to call a real HuggingFace
# Inference Endpoint (the endpoint URL + adapter name come from the use
# case's config, not here). Unset -> falls back to a local mock, same as
# Cortex above.
HF_API_TOKEN=

# src/serving/app.py. All optional -- unset means open/permissive, matching
# the README quickstart with no setup required. Set API_KEY to require a
# matching X-API-Key header on /score/* routes for anything beyond local dev.
CORS_ORIGINS=
API_KEY=
RATE_LIMIT_PER_MINUTE=
