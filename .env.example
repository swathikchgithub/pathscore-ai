# Copy to .env and fill in to run CortexExtractor against a live Snowflake
# account. If any of these are unset, CortexExtractor automatically falls
# back to a local mock Cortex client -- no Snowflake account required for
# local dev/demo.

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# Exactly one of these two:
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_PATH=
